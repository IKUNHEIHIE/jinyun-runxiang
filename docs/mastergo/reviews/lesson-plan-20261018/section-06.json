    "components": [],
    "rowTexts": [
      {
        "text": "课⁠堂⁠讲⁠稿",
        "parentType": "FRAME",
        "parentName": "组 5198"
      },
      {
        "text": "【导入】",
        "parentType": "FRAME",
        "parentName": "组 5202"
      },
      {
        "text": "同学们，今天我们要走进一项被",
        "parentType": "FRAME",
        "parentName": "组 5201"
      },
      {
        "text": "誉为\"东方艺术珍宝\"的传统工艺——景泰蓝。",
        "parentType": "FRAME",
        "parentName": "组 5201"
      },
      {
        "text": "请大家先看这件国宝级文物：明代的\"景泰蓝缠",
        "parentType": "FRAME",
        "parentName": "组 5201"
      },
      {
        "text": "枝莲纹出戟觚\"。",
        "parentType": "FRAME",
        "parentName": "组 5201"
      },
      {
        "text": "【新课讲授】",
        "parentType": "FRAME",
        "parentName": "组 5204"
      },
      {
        "text": "景泰蓝，学名\"铜胎掐丝珐",
        "parentType": "FRAME",
        "parentName": "组 5203"
      },
      {
        "text": "琅\"，起源于元代，盛于明代景泰年间，因以蓝",
        "parentType": "FRAME",
        "parentName": "组 5203"
      },
      {
        "text": "色釉料为主而得名。它的制作工艺极为繁复，",
        "parentType": "FRAME",
        "parentName": "组 5203"
      },
      {
        "text": "需经过制胎、掐丝、点蓝、烧蓝、磨光、镀金",
        "parentType": "FRAME",
        "parentName": "组 5203"
      },
      {
        "text": "六道工序。",
        "parentType": "FRAME",
        "parentName": "组 5203"
      },
      {
        "text": "【互动环节】",
        "parentType": "FRAME",
        "parentName": "组 5206"
      },
      {
        "text": "请同学们观察手中的景泰蓝",
        "parentType": "FRAME",
        "parentName": "组 5205"
      },
      {
        "text": "纹样样本，思考：这些缠枝莲纹、回纹、云纹",
        "parentType": "FRAME",
        "parentName": "组 5205"
      },
      {
        "text": "分别有什么吉祥寓意？",
        "parentType": "FRAME",
        "parentName": "组 5205"
      },
      {
        "text": "【总结】",
        "parentType": "FRAME",
        "parentName": "组 5208"
      },
      {
        "text": "景泰蓝不仅是一件工艺品，更是",
        "parentType": "FRAME",
        "parentName": "组 5207"
      },
      {
        "text": "中华文明智慧的结晶。2006年，景泰蓝制作技",
        "parentType": "FRAME",
        "parentName": "组 5207"
      },
      {
        "text": "艺被列入首批国家级非物质文化遗产名录。",
        "parentType": "FRAME",
        "parentName": "组 5207"
      },
      {
        "text": "展⁠开⁠完⁠整⁠讲⁠稿",
        "parentType": "FRAME",
        "parentName": "容器 18"
      }
    ]
  },
