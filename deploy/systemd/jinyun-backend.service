[Unit]
Description=Jinyun Runxiang FastAPI backend
After=network.target mariadb.service redis-server.service

[Service]
Type=simple
User=jinyun
Group=jinyun
WorkingDirectory=/opt/jinyun/backend
EnvironmentFile=/opt/jinyun/backend/.env
ExecStart=/opt/jinyun/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
